# Settings for running the backend on your laptop (copy to backend/.env; never commit the real file).
# The live site gets its own, different values on Render: see docs/DEPLOY.md.

DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/pr_risk_dev

# GitHub OAuth app (https://github.com/settings/developers). Its "Authorization callback URL" must be
# exactly GITHUB_REDIRECT_URI. Since Phase 19 the API lives under /api.
GITHUB_CLIENT_ID=<your-oauth-app-client-id>
GITHUB_CLIENT_SECRET=<your-oauth-app-client-secret>
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Public repos need no extra scope; use "read:user repo" only to analyse private repos
GITHUB_OAUTH_SCOPE=read:user

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=<fernet-key>
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<random-64-hex-chars>

# Phase 11: Gemini API (key from Google AI Studio; never commit the real key). Only the batch scripts
# call Gemini; the website only reads stored answers for GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Phase 19: who may read and who may write.
# Repositories ("owner/name", comma-separated) that anyone may open without logging in: the demo.
PUBLIC_REPOS=encode/httpx
# GitHub usernames allowed to ingest data and recompute metrics and labels. Empty = nobody.
ALLOWED_WRITERS=<your-github-username>

# Phase 16: where /api/auth/login?app=true sends the browser back after GitHub login. Default shown;
# use http://localhost:8000 when the app is served by FastAPI (Docker).
# FRONTEND_URL=http://localhost:5173
# Only needed if the React app calls the API from another address (VITE_API_URL). Default shown.
# FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
# Where FastAPI finds the built React app (frontend/dist). Default: backend/static.
# STATIC_DIR=../frontend/dist
# "production" turns on the startup safety checks; the live site sets it. Leave unset locally.
# APP_ENV=development

# Phase 17: tests use their own database (name must end in _test). See backend/README.md.
# TEST_DATABASE_URL=postgresql+psycopg://pr_risk_app:<password>@localhost:5432/pr_risk_test
