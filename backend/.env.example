DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/pr_risk_dev

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=<your-oauth-app-client-id>
GITHUB_CLIENT_SECRET=<your-oauth-app-client-secret>
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback
# Public repos need no extra scope; use "read:user repo" only to analyse private repos
GITHUB_OAUTH_SCOPE=read:user

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=<fernet-key>
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<random-64-hex-chars>

# Phase 11: Gemini API (key from Google AI Studio; never commit the real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Phase 16: browser origins allowed to call the API (comma-separated). Optional; the default is shown.
# FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
# Where /auth/login?app=true sends the browser back after GitHub login. Optional; default shown.
# FRONTEND_URL=http://localhost:5173

# Phase 17: tests use their own database (name must end in _test). See backend/README.md.
# TEST_DATABASE_URL=postgresql+psycopg://pr_risk_app:<password>@localhost:5432/pr_risk_test
