DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/pr_risk_dev

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=<your-oauth-app-client-id>
GITHUB_CLIENT_SECRET=<your-oauth-app-client-secret>
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback
# Public repos need no extra scope; use "read:user repo" only to analyse private repos
GITHUB_OAUTH_SCOPE=read:user

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=<fernet-key>
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<random-64-hex-chars>
